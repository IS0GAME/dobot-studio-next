<Page
    x:Class="DobotStudioNext.WinUI3.Views.SequencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localControls="using:DobotStudioNext.WinUI3.Controls">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0,4,0,0">
        <!-- Top Action & Execution CommandBar -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Teaching & Debugging Shortcuts -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Ctrl+T: Teach Point" Style="{ThemeResource AccentButtonStyle}" Click="OnTeachClicked" />
                    <Button Content="F10: Step Next" Click="OnStepNextClicked" />
                    <Button x:Name="RunButton" Content="F5: Run Sequence" Click="OnRunClicked" />
                    <Button Content="Esc: E-STOP" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="OnEStopClicked" />
                </StackPanel>

                <!-- Sequence Management & Excel Interop -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="+ Add Row" Click="OnAddRowClicked" />
                    <Button Content="Delete" Click="OnDeleteRowClicked" />

                    <!-- Batch Offset Flyout -->
                    <Button Content="Batch Offset">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" Width="220" Padding="8">
                                    <TextBlock Text="Batch Coordinate Offset" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Add delta to all points in sequence:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <NumberBox x:Name="OffsetDeltaX" Header="Delta X (mm)" Value="0" SpinButtonPlacementMode="Inline" />
                                    <NumberBox x:Name="OffsetDeltaY" Header="Delta Y (mm)" Value="0" SpinButtonPlacementMode="Inline" />
                                    <NumberBox x:Name="OffsetDeltaZ" Header="Delta Z (mm)" Value="0" SpinButtonPlacementMode="Inline" />
                                    <Button Content="Apply Offset" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnApplyOffsetClicked" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="Copy TSV" Click="OnCopyTsvClicked" />
                    <Button Content="Paste Excel" Click="OnPasteExcelClicked" />
                    <Button Content="Save" Click="OnSaveClicked" />
                    <Button Content="Open" Click="OnOpenClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center Sheet / Table Placeholder -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <ListView x:Name="MotionDataGrid" SelectionMode="Single" FontFamily="Cascadia Code, Consolas" FontSize="13">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="45,110,85,110,110,110,90,85,85,75,80" Padding="8,4">
                            <TextBlock Grid.Column="0" Text="{Binding Index}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding MotionStyle}" VerticalAlignment="Center" />
                            <localControls:FormulaCellControl Grid.Column="3"
                                                             RawValue="{Binding XRaw, Mode=TwoWay}"
                                                             EvaluatedInt="{Binding XInt, Mode=OneWay}"
                                                             FormulaInfo="{Binding FormulaInfoX, Mode=OneWay}"
                                                             IsLinked="{Binding IsFormulaLinked, Mode=TwoWay}" />
                            <localControls:FormulaCellControl Grid.Column="4"
                                                             RawValue="{Binding YRaw, Mode=TwoWay}"
                                                             EvaluatedInt="{Binding YInt, Mode=OneWay}"
                                                             FormulaInfo="{Binding FormulaInfoY, Mode=OneWay}"
                                                             IsLinked="{Binding IsFormulaLinked, Mode=TwoWay}" />
                            <localControls:FormulaCellControl Grid.Column="5"
                                                             RawValue="{Binding ZRaw, Mode=TwoWay}"
                                                             EvaluatedInt="{Binding ZInt, Mode=OneWay}"
                                                             FormulaInfo="{Binding FormulaInfoZ, Mode=OneWay}"
                                                             IsLinked="{Binding IsFormulaLinked, Mode=TwoWay}" />
                            <localControls:FormulaCellControl Grid.Column="6"
                                                             RawValue="{Binding RRaw, Mode=TwoWay}"
                                                             EvaluatedInt="{Binding RInt, Mode=OneWay}"
                                                             FormulaInfo="{Binding FormulaInfoR, Mode=OneWay}"
                                                             IsLinked="{Binding IsFormulaLinked, Mode=TwoWay}" />
                            <TextBlock Grid.Column="7" Text="{Binding PauseTime}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="{Binding ToolAction}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="9" Text="{Binding ToolState}" VerticalAlignment="Center" />
                            <Button Grid.Column="10" Content="Move" Tag="{Binding}" Click="OnMoveSinglePointClicked" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Bottom Status Bar / Telemetry Footer -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,8"
                Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="DebuggerStateText" Text="Debugger: IDLE" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SequenceStatsText" Text="2 Waypoints | 1.5s Cycle Time" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Simulator Pose:" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="PoseDisplayX" Text="X: 230" FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold" />
                    <TextBlock x:Name="PoseDisplayY" Text="Y: 0" FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold" />
                    <TextBlock x:Name="PoseDisplayZ" Text="Z: -10" FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold" />
                    <TextBlock x:Name="PoseDisplayR" Text="R: 0 deg" FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
