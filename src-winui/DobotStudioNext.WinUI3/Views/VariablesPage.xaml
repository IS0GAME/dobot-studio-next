<Page
    x:Class="DobotStudioNext.WinUI3.Views.VariablesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
            <!-- Header Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Parametric Variables Manager" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="Define global variables for robotic teaching (e.g., base_x, pitch, drop_z). Any formula referencing these variables will re-evaluate instantly into Plain Ints."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Insert 3x3 Grid Preset" Click="OnInsertGridPresetClicked" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Add / Edit Variable Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add or Update Variable" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="*,*,2*,Auto" HorizontalAlignment="Stretch">
                        <TextBox x:Name="VariableNameBox" Grid.Column="0" Header="Name" PlaceholderText="e.g. base_x" Margin="0,0,8,0" FontFamily="Cascadia Code, Consolas" />
                        <NumberBox x:Name="VariableValueBox" Grid.Column="1" Header="Value" Value="100" Margin="0,0,8,0" SpinButtonPlacementMode="Inline" />
                        <TextBox x:Name="VariableDescBox" Grid.Column="2" Header="Description" PlaceholderText="Optional notes" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="Save Variable" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="OnSaveVariableClicked" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Variables List -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Active Variables" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="VariableCountText" Text="3 variables defined" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <ListView x:Name="VariablesListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="150,120,*,Auto" Padding="0,6">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Code, Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="3" Content="Delete" Tag="{Binding Name}" Click="OnDeleteVariableClicked" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
