<Page
    x:Class="DobotStudioNext.WinUI3.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="800">
            <!-- Hardware Connection Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Hardware &amp; Serial Connection" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Dobot Magician Communication settings (115200 Baud, Protocol 0xAA 0xAA)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Selected Port" FontWeight="Medium" />
                            <ComboBox x:Name="PortComboBox" Width="200" PlaceholderText="Select COM Port" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Scan Ports" Click="OnScanPortsClicked" VerticalAlignment="Bottom" />
                    </Grid>

                    <ToggleSwitch x:Name="SimulatorToggle" Header="Virtual Kinematics Simulator Fallback" IsOn="True" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Dobot Studio Next Native" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Version 2.0.0 (WinUI 3 Standalone x64)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    <TextBlock Text="Architecture: 100% C# .NET 8 + Windows App SDK 1.6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Text="Features: Excel DataGrid, Parametric Formula Engine, Plain Int Conversion, Visual StepRunner" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="Zero Web/WebView2 Overhead (~35MB RAM footprint)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
